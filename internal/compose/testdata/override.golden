      "traefik.http.routers.outhaul-shop-d2.priority": "51"
      "traefik.http.routers.outhaul-shop-d2.rule": "Host(`shop.example.com`) && PathPrefix(`/webhooks`) && !PathRegexp(`(?i)(^|/|%2f|\\\\|%5c)(\\.|%2e){2}(/|%2f|\\\\|%5c|;|%3b|%3f|%23|%00|\\x00|$$)`)"
      "traefik.http.routers.outhaul-shop-d2.service": "outhaul-shop-d2"
      "traefik.http.services.outhaul-shop-d1.loadbalancer.server.port": "3000"
