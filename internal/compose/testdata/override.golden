      "traefik.http.routers.outhaul-shop-d3-tls.middlewares": "outhaul-shop-d3-noident"
      "traefik.http.routers.outhaul-shop-d3-tls.priority": "23"
      "traefik.http.routers.outhaul-shop-d3-tls.rule": "Host(`api.example.com`) && !PathRegexp(`(?i)(^|/|%2f|\\\\|%5c)(\\.|%2e){2}(/|%2f|\\\\|%5c|;|%3b|%3f|%23|%00|\\x00|$$)`)"
      "traefik.http.routers.outhaul-shop-d3-tls.service": "outhaul-shop-d3"
      "traefik.http.routers.outhaul-shop-d3-tls.tls": "true"
      "traefik.http.routers.outhaul-shop-d3-tls.tls.certresolver": "le"
      "traefik.http.routers.outhaul-shop-d3.entrypoints": "web"
      "traefik.http.routers.outhaul-shop-d3.middlewares": "outhaul-shop-d3-noident"
      "traefik.http.routers.outhaul-shop-d3.priority": "23"
      "traefik.http.routers.outhaul-shop-d3.rule": "Host(`api.example.com`) && !PathRegexp(`(?i)(^|/|%2f|\\\\|%5c)(\\.|%2e){2}(/|%2f|\\\\|%5c|;|%3b|%3f|%23|%00|\\x00|$$)`)"
      "traefik.http.routers.outhaul-shop-d3.service": "outhaul-shop-d3"
      "traefik.http.services.outhaul-shop-d3.loadbalancer.server.port": "8080"
  "web":
    networks:
      default: {}
      "outhaul": {}
    labels:
      "outhaul.app": "shop"
      "outhaul.managed": "true"
      "traefik.docker.network": "outhaul"
      "traefik.enable": "true"
      "traefik.http.middlewares.outhaul-shop-d1-gate.forwardauth.address": "http://host.docker.internal:8080/gate/check"
      "traefik.http.middlewares.outhaul-shop-d1-gate.forwardauth.authresponseheaders": "X-Outhaul-User"
      "traefik.http.middlewares.outhaul-shop-d1-gate.forwardauth.trustforwardheader": "false"
      "traefik.http.middlewares.outhaul-shop-d1-noalias.headers.customrequestheaders.X-Outhaul_User": ""
      "traefik.http.middlewares.outhaul-shop-d1-noalias.headers.customrequestheaders.X_Outhaul-User": ""
      "traefik.http.middlewares.outhaul-shop-d1-noalias.headers.customrequestheaders.X_Outhaul_User": ""
      "traefik.http.middlewares.outhaul-shop-d1-noalias.headers.customresponseheaders.CDN-Cache-Control": "no-store"
      "traefik.http.middlewares.outhaul-shop-d1-noalias.headers.customresponseheaders.Cloudflare-CDN-Cache-Control": "no-store"
      "traefik.http.middlewares.outhaul-shop-d2-noident.headers.customrequestheaders.X-Outhaul-User": ""
