# Generated by Outhaul on every deploy — do not edit.
# Publishes stack services on their domains via the shared Traefik network.
services:
  "api":
    networks:
      default: {}
      "outhaul": {}
    labels:
      "outhaul.app": "shop"
      "outhaul.managed": "true"
      "traefik.docker.network": "outhaul"
      "traefik.enable": "true"
      "traefik.http.middlewares.outhaul-shop-d3-noident.headers.customrequestheaders.X-Outhaul-User": ""
      "traefik.http.middlewares.outhaul-shop-d3-noident.headers.customrequestheaders.X-Outhaul_User": ""
      "traefik.http.middlewares.outhaul-shop-d3-noident.headers.customrequestheaders.X_Outhaul-User": ""
      "traefik.http.middlewares.outhaul-shop-d3-noident.headers.customrequestheaders.X_Outhaul_User": ""
