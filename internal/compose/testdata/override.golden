      "traefik.http.routers.outhaul-shop-d1-tls.service": "outhaul-shop-d1"
      "traefik.http.routers.outhaul-shop-d1-tls.tls": "true"
      "traefik.http.routers.outhaul-shop-d1-tls.tls.certresolver": "le"
      "traefik.http.routers.outhaul-shop-d1.entrypoints": "web"
      "traefik.http.routers.outhaul-shop-d1.middlewares": "outhaul-shop-d1-gate,outhaul-shop-d1-noalias"
      "traefik.http.routers.outhaul-shop-d1.priority": "24"
      "traefik.http.routers.outhaul-shop-d1.rule": "Host(`shop.example.com`) && !PathRegexp(`(?i)(^|/|%2f|\\\\|%5c)(\\.|%2e){2}(/|%2f|\\\\|%5c|;|%3b|%3f|%23|%00|\\x00|$$)`)"
      "traefik.http.routers.outhaul-shop-d1.service": "outhaul-shop-d1"
      "traefik.http.routers.outhaul-shop-d2-tls.entrypoints": "websecure"
      "traefik.http.routers.outhaul-shop-d2-tls.middlewares": "outhaul-shop-d2-noident"
      "traefik.http.routers.outhaul-shop-d2-tls.priority": "51"
