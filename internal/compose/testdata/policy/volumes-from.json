{
  "name": "policy",
  "networks": {
    "default": {
      "name": "policy_default",
      "ipam": {}
    }
  },
  "services": {
    "db": {
      "command": null,
      "entrypoint": null,
      "image": "postgres:16",
      "networks": {
        "default": null
      }
    },
    "other": {
      "command": null,
      "entrypoint": null,
      "image": "nginx:1.27",
      "networks": {
        "default": null
      },
      "volumes_from": [
        "container:db"
      ]
    },
    "web": {
      "command": null,
      "entrypoint": null,
      "image": "nginx:1.27",
      "networks": {
        "default": null
      },
      "volumes_from": [
        "db"
      ],
      "depends_on": {
        "db": {
          "condition": "service_started",
          "required": true
        }
      }
    }
  }
}