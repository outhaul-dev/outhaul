{
  "name": "policy",
  "networks": {
    "default": {
      "name": "policy_default",
      "ipam": {}
    }
  },
  "services": {
    "web": {
      "command": null,
      "entrypoint": null,
      "image": "nginx:1.27",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "bind",
          "source": "/work/host",
          "target": "/host",
          "bind": {}
        },
        {
          "type": "image",
          "source": "docker.io/library/nginx:1.27",
          "target": "/image"
        },
        {
          "type": "npipe",
          "source": "\\\\\\\\.\\\\pipe\\\\example",
          "target": "/npipe"
        },
        {
          "type": "cluster",
          "source": "example",
          "target": "/cluster"
        }
      ]
    }
  }
}