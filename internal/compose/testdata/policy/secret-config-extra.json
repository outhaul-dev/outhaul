{
  "name": "policy",
  "services": {
    "web": {
      "image": "nginx:1.27",
      "secrets": [
        {
          "source": "secretdriver"
        },
        {
          "source": "secretopts"
        }
      ],
      "configs": [
        {
          "source": "configdriver"
        },
        {
          "source": "configopts"
        }
      ]
    }
  },
  "secrets": {
    "secretdriver": {
      "name": "policy_secretdriver",
      "driver": "example"
    },
    "secretopts": {
      "name": "policy_secretopts",
      "driver_opts": {
        "foo": "bar"
      }
    }
  },
  "configs": {
    "configdriver": {
      "name": "policy_configdriver",
      "driver": "example"
    },
    "configopts": {
      "name": "policy_configopts",
      "driver_opts": {
        "foo": "bar"
      }
    }
  }
}
