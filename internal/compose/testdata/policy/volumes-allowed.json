{
  "name": "policy",
  "networks": {
    "default": {
      "name": "policy_default",
      "ipam": {}
    }
  },
  "services": {
    "web": {
      "command": null,
      "entrypoint": null,
      "image": "nginx:1.27",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "data",
          "target": "/data",
          "volume": {}
        },
        {
          "type": "volume",
          "target": "/anonymous",
          "volume": {}
        },
        {
          "type": "tmpfs",
          "target": "/tmp"
        }
      ]
    }
  },
  "volumes": {
    "data": {
      "name": "policy_data"
    }
  }
}