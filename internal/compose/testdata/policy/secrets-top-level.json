{
  "name": "policy",
  "networks": {
    "default": {
      "name": "policy_default",
      "ipam": {}
    }
  },
  "secrets": {
    "drvbad": {
      "name": "policy_drvbad",
      "file": "/work/missing.txt",
      "driver": "example"
    },
    "labelsgood": {
      "name": "policy_labelsgood",
      "environment": "TOKEN",
      "labels": {
        "team": "example"
      }
    },
    "namegood": {
      "name": "custom-name",
      "environment": "TOKEN"
    },
    "optsbad": {
      "name": "policy_optsbad",
      "file": "/work/missing.txt",
      "driver_opts": {
        "foo": "bar"
      }
    },
    "tmplbad": {
      "name": "policy_tmplbad",
      "file": "/work/missing.txt",
      "template_driver": "golang"
    }
  },
  "services": {
    "web": {
      "command": null,
      "entrypoint": null,
      "image": "nginx:1.27",
      "networks": {
        "default": null
      },
      "secrets": [
        {
          "source": "labelsgood",
          "target": "/run/secrets/labelsgood"
        },
        {
          "source": "namegood",
          "target": "/run/secrets/namegood"
        },
        {
          "source": "drvbad",
          "target": "/run/secrets/drvbad"
        },
        {
          "source": "optsbad",
          "target": "/run/secrets/optsbad"
        },
        {
          "source": "tmplbad",
          "target": "/run/secrets/tmplbad"
        }
      ]
    }
  }
}