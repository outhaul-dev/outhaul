{
  "name": "policy",
  "networks": {
    "default": {
      "name": "policy_default",
      "ipam": {}
    }
  },
  "secrets": {
    "extbad": {
      "name": "extbad",
      "external": true
    },
    "filebad": {
      "name": "policy_filebad",
      "file": "/work/missing.txt"
    },
    "good": {
      "name": "policy_good",
      "environment": "SECRET"
    }
  },
  "services": {
    "web": {
      "command": null,
      "entrypoint": null,
      "image": "nginx:1.27",
      "networks": {
        "default": null
      },
      "secrets": [
        {
          "source": "good",
          "target": "/run/secrets/good"
        },
        {
          "source": "filebad",
          "target": "/run/secrets/filebad"
        },
        {
          "source": "extbad",
          "target": "/run/secrets/extbad"
        }
      ]
    }
  }
}