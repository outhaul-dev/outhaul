{
  "name": "policy",
  "networks": {
    "default": {
      "name": "policy_default",
      "ipam": {}
    }
  },
  "services": {
    "allowed": {
      "deploy": {
        "resources": {
          "limits": {
            "cpus": 0.5,
            "memory": "268435456"
          }
        },
        "restart_policy": {
          "condition": "on-failure"
        },
