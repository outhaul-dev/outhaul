                "capabilities": [
                  "gpu"
                ],
                "count": -1
              }
            ],
            "generic_resources": [
              {
                "discrete_resource_spec": {
                  "kind": "gpu",
                  "value": 1
                }
              }
            ]
          }
        },
        "placement": {}
      },
      "command": null,
      "entrypoint": null,
      "image": "nginx:1.27",
      "networks": {
        "default": null
      }
    }
  }
