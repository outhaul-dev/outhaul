{
  "name": "policy",
  "services": {
    "web": {
      "image": "nginx:1.27",
      "post_start": [
        {
          "command": [
            "echo",
            "started"
          ],
          "user": "root",
          "working_dir": "/app",
          "environment": {
            "APP_ENV": "production"
          }
        }
      ],
      "pre_stop": [
        {
          "command": [
            "echo",
            "stopping"
          ],
          "user": "root",
          "working_dir": "/app",
          "environment": {
            "APP_ENV": "production"
          }
        }
      ]
    }
  }
}
