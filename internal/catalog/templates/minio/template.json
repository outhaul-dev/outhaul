{
  "name": "MinIO",
  "description": "S3-compatible object storage with a web console.",
  "version": "RELEASE.2025-04-22T22-12-26Z",
  "tags": ["storage", "s3"],
  "links": {
    "website": "https://min.io",
    "docs": "https://min.io/docs/minio/container/index.html",
    "github": "https://github.com/minio/minio"
  },
  "variables": {
    "console_domain": "${domain}",
    "api_domain": "${domain}"
  },
  "env": [
    { "key": "MINIO_ROOT_USER", "value": "${username}" },
    { "key": "MINIO_ROOT_PASSWORD", "value": "${password:20}", "secret": true },
    { "key": "CONSOLE_DOMAIN", "value": "${console_domain}" },
    { "key": "API_DOMAIN", "value": "${api_domain}" }
  ],
  "domains": [
    { "service": "minio", "port": 9001, "host": "${console_domain}" },
    { "service": "minio", "port": 9000, "host": "${api_domain}" }
  ]
}
