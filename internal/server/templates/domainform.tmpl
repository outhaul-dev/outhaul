{{define "domainform"}}
<dialog id="domain-dialog" class="modal" open aria-labelledby="domain-dialog-title">
  <form method="post" id="domain-form" action="/apps/{{.App.ID}}/domains">
    <div class="modal-head">
      <h3 class="modal-title" id="domain-dialog-title">New domain</h3>
      <button type="button" class="modal-close" aria-label="Close" onclick="this.closest('dialog').close()">&times;</button>
    </div>
    <div class="modal-body">
      <div class="wizard-steps">
        <span class="dot" data-dot>1 · Host</span>
        <span class="dot" data-dot>2 · Target</span>
        <span class="dot" data-dot>3 · HTTPS and sign-in</span>
      </div>

      <!-- Step 1: Host -->
      <div class="stack" data-step>
        {{if .DefaultDomain}}
        <label class="field-check">
          <input type="radio" name="host_kind" value="default">
          <span>Default domain {{template "hint" "This app's name under the server's domain suffix. It resolves here already, so no DNS record is needed."}}</span>
        </label>
        <label class="field" data-host="default" hidden>
          <span>Generated host</span>
          <input type="text" value="{{.DefaultDomain}}" disabled>
        </label>
        {{end}}
        <label class="field-check">
          <input type="radio" name="host_kind" value="custom" checked>
          <span>Custom domain {{template "hint" "A hostname you own and have pointed at this server's IP with a DNS A record, e.g. shop.example.com."}}</span>
        </label>
        <label class="field" data-host="custom">
          <span>Host</span>
          <input type="text" name="host" id="domain-host" placeholder="shop.example.com">
        </label>
        {{if and .ServerIP (not .DefaultDomain)}}
        <label class="field-check">
          <input type="radio" name="host_kind" value="sslip">
          <span>Free sslip.io domain {{template "hint" "A zero-config hostname that resolves to this server's IP via sslip.io — handy for testing without owning a domain."}}</span>
        </label>
        <label class="field" data-host="sslip" hidden>
          <span>Generated host</span>
          <input type="text" value="{{.App.Name}}.{{.ServerIP}}.sslip.io" disabled>
        </label>
        {{end}}
      </div>

      <!-- Step 2: Target -->
      <div class="stack" data-step>
        {{if eq .App.Kind "compose"}}
        <label class="field">
          <span>Service {{template "hint" "Which service in the compose stack this domain routes to."}}</span>
          <input type="text" name="service" id="domain-service" list="domain-service-options" placeholder="web" autocomplete="off">
          <datalist id="domain-service-options">
            {{range .Stack}}<option value="{{.Service}}"></option>{{end}}
          </datalist>
        </label>
        <label class="field">
          <span>Container port {{template "hint" "The port that service listens on inside its container, e.g. 3000."}}</span>
          <input type="text" name="port" id="domain-port" placeholder="3000" inputmode="numeric">
        </label>
        {{end}}
        <label class="field">
          <span>Path <em>(optional)</em> {{template "hint" "Route only requests under this URL prefix, e.g. /api. Leave blank to route the whole host."}}</span>
          <input type="text" name="path" placeholder="/api">
        </label>
        <label class="field">
          <span>Internal path <em>(optional)</em> {{template "hint" "Rewrite the matched prefix to this before forwarding to the container. Blank = forward unchanged; '/' strips the prefix; '/v1' replaces it. Requires a path above."}}</span>
          <input type="text" name="internal_path" placeholder="/">
        </label>
      </div>

      <!-- Step 3: HTTPS and sign-in -->
      <div class="stack" data-step>
        {{if .LocalCA}}
        <label class="field-check">
          <input type="checkbox" name="tls" id="domain-tls"{{if or .TLSAvailable .HTTPSOnly}} checked{{end}}{{if or (not .TLSAvailable) .HTTPSOnly}} disabled{{end}}>
          <span>Automate HTTPS (local CA) {{template "hint" "Certificate minted by this server's local CA — devices that trust the root (Settings → Download CA certificate) see it as valid."}}</span>
        </label>
        {{else}}
        <label class="field-check">
          <input type="checkbox" name="tls" id="domain-tls"{{if or .TLSAvailable .HTTPSOnly}} checked{{end}}{{if or (not .TLSAvailable) .HTTPSOnly}} disabled{{end}}>
          <span>Automate HTTPS (Let's Encrypt) {{template "hint" "Obtain and renew a TLS certificate for this domain automatically. Requires DNS pointing here and port 443 reachable."}}</span>
        </label>
        {{end}}
        {{if not .TLSAvailable}}
        <p class="env-note">HTTPS automation needs an ACME email or OUTHAUL_LOCAL_CA in the server config. Set one to enable per-domain certificates.</p>
        {{end}}
        {{if .HTTPSOnly}}
        <p class="env-note">This server serves HTTPS only. Every domain is served over HTTPS and this can't be changed here.</p>
        {{end}}

        <div class="protect">
          <input type="hidden" name="protected_offered" value="1">
          <input type="hidden" name="protected_was" id="domain-protected-was" value="0">
          <input type="hidden" name="exception_was" id="domain-exception-was" value="0">
          <input type="hidden" name="others_was" value="{{.OthersWas}}">
          <label class="field-check">
            <input type="checkbox" class="switch" role="switch" name="protected" id="domain-protected"{{if not .ProtectionAvailable}} disabled{{end}}>
            <span>Require sign-in</span>
          </label>
          <p class="muted">People must sign in to Outhaul before they reach this address. Everyone who can sign in gets through, and the app receives their name in the <span class="mono">X-Outhaul-User</span> header.</p>
          {{if not .ProtectionAvailable}}
          <p class="env-note" id="domain-protect-reason">{{.ProtectionReason}}</p>
          <p class="env-note" id="domain-protect-reason-on" hidden>Sign-in isn't available right now, so nobody can get through this address. You can turn this off to open it, or fix the cause: {{.ProtectionReason}}</p>
          {{end}}
          <div class="alert alert-warn protect-note" id="domain-protect-note">
            Turning sign-in on or off redeploys this app if it is running, and so does changing the host or path of a domain on a host that requires sign-in.{{if .TLSAvailable}} A domain that requires sign-in is always served over HTTPS, even with Automate HTTPS off.{{end}}
            {{with .ProtectionWarning}}<strong>{{.}}</strong>{{end}}
            {{range .AlsoRedeploys}}<p class="protect-also" data-also-host="{{.Host}}">{{.Sentence}}</p>{{end}}
            {{range .PreviewRedeploys}}<p class="protect-also" data-also-preview>{{.Sentence}}</p>{{end}}
            {{if .HasPreviews}}<p class="protect-also" id="domain-previews-stay">Existing previews stay protected. New ones will be open.</p>{{end}}
          </div>
        </div>
        <p class="muted env-note">Other domain changes apply on this app's next deploy.</p>
      </div>
    </div>

    <div class="modal-foot">
      <button type="button" class="btn" data-nav="back">Back</button>
      <span class="spacer"></span>
      <button type="button" class="btn btn-primary" data-nav="next">Next &rarr;</button>
      <button type="submit" class="btn btn-primary" data-nav="submit">Create domain</button>
    </div>
  </form>
</dialog>

<script>
  // Domain wizard: same progressive-enhancement + step pattern as the app-create
  // wizard. Ships open (inline, usable without JS); JS makes it modal and exposes
  // openDomainDialog(row) so the Domains section can open it fresh or prefilled
  // for an edit. The server validates the submitted form regardless.
  (function () {
    var dialog = document.getElementById('domain-dialog');
    if (!dialog) return;
    var form = document.getElementById('domain-form');
    var addAction = form.getAttribute('action');
    var title = document.getElementById('domain-dialog-title');
    var submitBtn = dialog.querySelector('[data-nav="submit"]');

    function applyHostKind() {
      var checked = dialog.querySelector('input[name="host_kind"]:checked');
      var kind = checked ? checked.value : 'custom';
      dialog.querySelectorAll('[data-host]').forEach(function (el) {
        el.hidden = el.getAttribute('data-host') !== kind;
      });
      var host = document.getElementById('domain-host');
      if (host) host.required = kind === 'custom';
    }
    dialog.querySelectorAll('input[name="host_kind"]').forEach(function (r) {
      r.addEventListener('change', applyHostKind);
    });

    var steps = Array.prototype.slice.call(dialog.querySelectorAll('[data-step]'));
    var dots = Array.prototype.slice.call(dialog.querySelectorAll('[data-dot]'));
    var backBtn = dialog.querySelector('[data-nav="back"]');
    var nextBtn = dialog.querySelector('[data-nav="next"]');
    var current = 0;
    function show(i) {
      current = i;
      steps.forEach(function (s, n) { s.hidden = n !== i; });
      dots.forEach(function (d, n) {
        d.classList.toggle('current', n === i);
        d.classList.toggle('done', n < i);
      });
      if (backBtn) backBtn.disabled = i === 0;
      if (nextBtn) nextBtn.hidden = i === steps.length - 1;
      if (submitBtn) submitBtn.hidden = i !== steps.length - 1;
    }
    function stepValid() {
      var fields = steps[current].querySelectorAll('input, select, textarea');
      for (var i = 0; i < fields.length; i++) {
        if (fields[i].offsetParent !== null && !fields[i].checkValidity()) {
          fields[i].reportValidity();
          return false;
        }
      }
      return true;
    }
    if (nextBtn) nextBtn.addEventListener('click', function () {
      if (stepValid() && current < steps.length - 1) show(current + 1);
    });
    if (backBtn) backBtn.addEventListener('click', function () {
      if (current > 0) show(current - 1);
    });
    form.addEventListener('submit', function (e) {
      if (current < steps.length - 1) {
        e.preventDefault();
        if (stepValid()) show(current + 1);
      }
    });

    // The redeploy note and the warning of what will ship show while the switch
    // is on, when the row being edited was protected (turning it off redeploys
    // too), or when it is an open row on a host that requires sign-in and its
    // host or path has changed. Without JS they stay visible.
    //
    // When sign-in is unavailable the server renders the switch disabled, for
    // a new or open row; a protected row's switch is enabled, so it can be
    // turned off, with its own reason.
    var protect = document.getElementById('domain-protected');
    var protectNote = document.getElementById('domain-protect-note');
    var reasonOff = document.getElementById('domain-protect-reason');
    var reasonOn = document.getElementById('domain-protect-reason-on');
    var protectLocked = !!(protect && protect.disabled);
    var hostInput = document.getElementById('domain-host');
    var pathInput = form.querySelector('input[name="path"]');
    var editedProtected = false, editedException = false, origHost = '', origPath = '';
    // What the dialog was filled from. The server refuses an edit whose row
    // has changed since, rather than saving over what this page didn't show.
    var protectedWas = document.getElementById('domain-protected-was');
    var exceptionWas = document.getElementById('domain-exception-was');
    function moved() {
      var kind = dialog.querySelector('input[name="host_kind"]:checked');
      if (kind && kind.value !== 'custom') return true;
      var host = hostInput ? hostInput.value.trim().toLowerCase() : '';
      var path = pathInput ? pathInput.value.trim() : '';
      return host !== origHost || path !== origPath;
    }
    // Other apps a save would also redeploy are named per host. They show
    // only for a save that requires sign-in on the host being saved (a new
    // protected row, the switch turned on, or a protected row moved), and
    // only the lines for that host.
    var alsoLines = Array.prototype.slice.call(dialog.querySelectorAll('[data-also-host]'));
    function requiresSignInHere() {
      return !!(protect && protect.checked) && (!editedProtected || moved());
    }
    function currentHost() {
      var kind = dialog.querySelector('input[name="host_kind"]:checked');
      if (kind && kind.value !== 'custom') {
        var gen = dialog.querySelector('[data-host="' + kind.value + '"] input');
        return gen ? gen.value.trim().toLowerCase() : '';
      }
      return hostInput ? hostInput.value.trim().toLowerCase() : '';
    }
    // The app's previews get the protection of a row saved with the switch
    // on; one turned off leaves them protected, and the dialog says so.
    var previewLines = Array.prototype.slice.call(dialog.querySelectorAll('[data-also-preview]'));
    var previewsStay = document.getElementById('domain-previews-stay');
    function applyProtect() {
      var on = !!(protect && protect.checked);
      if (protectNote) protectNote.hidden = !(on || editedProtected || (editedException && moved()));
      var host = currentHost();
      var here = requiresSignInHere();
      alsoLines.forEach(function (p) { p.hidden = !here || p.getAttribute('data-also-host') !== host; });
      previewLines.forEach(function (p) { p.hidden = !on; });
      if (previewsStay) previewsStay.hidden = !(editedProtected && !on);
    }
    if (protect) protect.addEventListener('change', applyProtect);
    [hostInput, pathInput].forEach(function (el) { if (el) el.addEventListener('input', applyProtect); });
    dialog.querySelectorAll('input[name="host_kind"]').forEach(function (r) {
      r.addEventListener('change', applyProtect);
    });
    function applyLock() {
      if (protect) protect.disabled = protectLocked && !editedProtected;
      if (reasonOff) reasonOff.hidden = editedProtected;
      if (reasonOn) reasonOn.hidden = !editedProtected;
    }

    applyHostKind();
    applyProtect();
    show(0);

    if (dialog.open) dialog.close();
    dialog.addEventListener('click', function (e) { if (e.target === dialog) dialog.close(); });

    function setField(name, val) {
      var el = form.querySelector('[name="' + name + '"]');
      if (!el) return;
      if (el.type === 'checkbox') { el.checked = val === '1' || val === 'true'; }
      else { el.value = val; }
    }
    window.openDomainDialog = function (row) {
      if (row) {
        title.textContent = 'Edit domain';
        submitBtn.textContent = 'Save domain';
        form.setAttribute('action', addAction + '/' + row.id);
        var custom = form.querySelector('input[name="host_kind"][value="custom"]');
        if (custom) custom.checked = true;
        applyHostKind();
        setField('host', row.host || '');
        setField('service', row.service || '');
        setField('port', row.port || '');
        setField('path', row.path || '');
        setField('internal_path', row.internal_path || '');
        var tls = document.getElementById('domain-tls');
        if (tls && !tls.disabled) tls.checked = row.tls === '1';
        editedProtected = row.protected === '1';
        editedException = row.exception === '1';
        protectedWas.value = row.protected === '1' ? '1' : '0';
        exceptionWas.value = row.exception === '1' ? '1' : '0';
        origHost = (row.host || '').toLowerCase();
        origPath = row.path || '';
        if (protect) protect.checked = editedProtected;
      } else {
        title.textContent = 'New domain';
        submitBtn.textContent = 'Create domain';
        form.setAttribute('action', addAction);
        form.reset();
        editedProtected = false;
        editedException = false;
        protectedWas.value = '0';
        exceptionWas.value = '0';
        applyHostKind();
      }
      applyLock();
      applyProtect();
      show(0);
      dialog.showModal();
    };
  })();
</script>
{{end}}
