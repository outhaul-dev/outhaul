{{define "content"}}
<div class="pagehead"><h1>Settings</h1></div>

{{if .Notice}}<div class="alert alert-success">{{.Notice}}</div>{{end}}
{{if .Error}}<div class="alert alert-error">{{.Error}}</div>{{end}}

<section class="panel">
  <h2 class="panel-title">GitHub App</h2>
  {{if .NeedsPublicURL}}
  <p class="env-note">Set <code>OUTHAUL_PUBLIC_URL</code> to your admin UI's public HTTPS URL to enable GitHub App setup.</p>
  {{else if .GithubInstalled}}
  <p>Connected as <span class="mono">{{.GithubSlug}}</span> and installed. Private GitHub repos and auto-deploy on push are available.</p>
  {{else if .GithubSlug}}
  <p>App <span class="mono">{{.GithubSlug}}</span> created but not installed. <a href="/github/connect">Finish installation</a>.</p>
  {{else}}
  <p><a href="/github/connect">Connect a GitHub App</a> to deploy private GitHub repos and auto-deploy on push.</p>
  {{end}}
</section>

<section class="panel">
  <h2 class="panel-title">Backup destinations</h2>
  {{if .Destinations}}
  <table class="table">
    <thead><tr><th>Name</th><th>Endpoint</th><th>Bucket</th><th>Region</th><th></th></tr></thead>
    <tbody>
      {{range .Destinations}}
      <tr>
        <td class="mono">{{.Name}}</td>
        <td class="mono muted truncate">{{.Endpoint}}</td>
        <td class="mono muted">{{.Bucket}}</td>
        <td class="mono muted">{{if .Region}}{{.Region}}{{else}}—{{end}}</td>
        <td class="row-actions">
          <form method="post" action="/settings/destinations/{{.ID}}/test" class="inline"><button type="submit" class="btn btn-quiet">Test</button></form>
          <form method="post" action="/settings/destinations/{{.ID}}/delete" class="inline"><button type="submit" class="linkbtn">remove</button></form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="empty">No destinations. Add an S3-compatible bucket (AWS S3, MinIO, R2, B2, Wasabi, …) to enable backups.</p>
  {{end}}
  <form method="post" action="/settings/destinations" class="grid-form env-add">
    <label class="field"><span>Name</span><input type="text" name="name" placeholder="minio" required></label>
    <label class="field"><span>Endpoint</span><input type="text" name="endpoint" placeholder="https://s3.eu-west-2.amazonaws.com" required></label>
    <label class="field"><span>Region (optional)</span><input type="text" name="region" placeholder="eu-west-2"></label>
    <label class="field"><span>Bucket</span><input type="text" name="bucket" placeholder="outhaul-backups" required></label>
    <label class="field"><span>Access key</span><input type="text" name="access_key" required></label>
    <label class="field"><span>Secret key</span><input type="password" name="secret_key" autocomplete="off" required></label>
    <button type="submit" class="btn btn-primary">Add destination</button>
  </form>
  <p class="muted env-note">The secret key is stored encrypted at rest. Addressing is path-style, which every S3-compatible service accepts; Test writes and deletes a small probe object.</p>
</section>

<section class="panel">
  <h2 class="panel-title">Push keys</h2>
  <p class="muted env-note">SSH public keys allowed to <code>git push</code> to deploy. Add your laptop or CI key, then push to a push-to-deploy app's <code>ssh://git@…</code> remote.</p>
  {{if .PushKeys}}
  <table class="table">
    <thead><tr><th>Label</th><th>Fingerprint</th><th>Added</th><th>Last used</th><th></th></tr></thead>
    <tbody>
      {{range .PushKeys}}
      <tr>
        <td>{{.Label}}</td>
        <td class="mono muted truncate">{{.Fingerprint}}</td>
        <td class="muted">{{.CreatedAt.Format "2006-01-02"}}</td>
        <td class="muted">{{if .LastUsedAt}}{{.LastUsedAt.Format "2006-01-02"}}{{else}}—{{end}}</td>
        <td class="row-actions">
          <form method="post" action="/settings/push-keys/{{.ID}}/delete" class="inline"><button type="submit" class="linkbtn">remove</button></form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="empty">No push keys yet.</p>
  {{end}}
  <form method="post" action="/settings/push-keys" class="grid-form env-add">
    <label class="field"><span>Label</span><input type="text" name="label" placeholder="james-laptop" required></label>
    <label class="field"><span>Public key</span><input type="text" name="public_key" placeholder="ssh-ed25519 AAAA… you@host" required></label>
    <button type="submit" class="btn btn-primary">Add key</button>
  </form>
</section>

<section class="panel">
  <h2 class="panel-title">Git-push SSH port</h2>
  <p class="muted env-note">The address the git-push server listens on. Current: <span class="mono">{{if .SSHAddr}}{{.SSHAddr}}{{else}}not running{{end}}</span>. Remember to open this port on your firewall.</p>
  <form method="post" action="/settings/ssh" class="grid-form">
    <label class="field"><span>Listen address</span><input type="text" name="ssh_addr" value="{{.SSHAddr}}" placeholder=":2222" required></label>
    <button type="submit" class="btn btn-primary">Update port</button>
  </form>
</section>

<section class="panel">
  <h2 class="panel-title">Cloudflare Tunnel</h2>
  {{if .TunnelAvailable}}
    {{if .TunnelEnabled}}
      <p class="muted env-note">The tunnel is <strong>enabled</strong>. Outhaul is reachable through Cloudflare with no exposed ports. In the Cloudflare Zero&nbsp;Trust dashboard, point each public hostname at <code>http://outhaul-traefik:80</code>. While the tunnel is on, Let's Encrypt is disabled — Cloudflare provides HTTPS.</p>
      <form method="post" action="/settings/tunnel/disable" class="grid-form">
        <button type="submit" class="btn btn-danger">Disable tunnel</button>
      </form>
    {{else}}
      <p class="muted env-note">Expose apps without a public IP or port-forwarding. Create a tunnel in the Cloudflare Zero&nbsp;Trust dashboard, copy its connector token, and paste it here. Then point each public hostname at <code>http://outhaul-traefik:80</code>. Enabling the tunnel takes over ingress from Let's Encrypt (Cloudflare terminates HTTPS).</p>
      <form method="post" action="/settings/tunnel/enable" class="grid-form">
        <label class="field"><span>Connector token</span><input type="password" name="token" placeholder="eyJhIjoi…" autocomplete="off" required></label>
        <button type="submit" class="btn">Enable tunnel</button>
      </form>
    {{end}}
  {{else}}
    <p class="muted env-note">Tunnel management is unavailable — Docker must be reachable to run the cloudflared connector.</p>
  {{end}}
</section>

<section class="panel">
  <h2 class="panel-title">Change password</h2>
  <form method="post" action="/settings/password" class="grid-form">
    <label class="field"><span>Current password</span><input type="password" name="current" autocomplete="current-password" required></label>
    <label class="field"><span>New password <em>(min 8 characters)</em></span><input type="password" name="new" autocomplete="new-password" required></label>
    <button type="submit" class="btn btn-primary">Update password</button>
  </form>
</section>
{{end}}
