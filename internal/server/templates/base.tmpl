{{define "base"}}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{if .Title}}{{.Title}} · {{end}}Outhaul</title>
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/htmx.min.js" defer></script>
</head>
<body>
  {{if .HideChrome}}
  <main class="container">
    {{template "content" .}}
  </main>
  {{else}}
  <div class="shell">
    <aside class="sidebar">
      <a class="sidebar-brand" href="/">outhaul</a>
      <nav class="sidebar-nav">
        <div class="nav-group">
          <a class="nav-item {{if eq .Active "overview"}}active{{end}}" href="/">Overview</a>
        </div>
        <div class="nav-group">
          <div class="nav-group-label">Deploy</div>
          <a class="nav-item {{if eq .Active "projects"}}active{{end}}" href="/projects">Projects</a>
          <a class="nav-item {{if eq .Active "apps"}}active{{end}}" href="/apps">Apps</a>
          <a class="nav-item {{if eq .Active "templates"}}active{{end}}" href="/templates">Templates</a>
          <a class="nav-item {{if eq .Active "containers"}}active{{end}}" href="/containers">Containers</a>
        </div>
        <div class="nav-group">
          <div class="nav-group-label">Resources</div>
          <a class="nav-item {{if eq .Active "databases"}}active{{end}}" href="/databases">Databases</a>
          <a class="nav-item {{if eq .Active "volumes"}}active{{end}}" href="/volumes">Volumes</a>
          <a class="nav-item {{if eq .Active "registry"}}active{{end}}" href="/registry">Registry <span class="soon">soon</span></a>
          <a class="nav-item {{if eq .Active "domains"}}active{{end}}" href="/domains">Domains</a>
        </div>
        <div class="nav-group">
          <div class="nav-group-label">System</div>
          <a class="nav-item {{if eq .Active "infrastructure"}}active{{end}}" href="/infrastructure">Infrastructure <span class="soon">soon</span></a>
          <a class="nav-item {{if eq .Active "metrics"}}active{{end}}" href="/metrics">Metrics</a>
        </div>
      </nav>
      <div class="sidebar-foot">
        <a class="nav-item {{if eq .Active "settings"}}active{{end}}" href="/settings">Settings</a>
        <form method="post" action="/logout" class="inline"><button type="submit" class="nav-item linkbtn">Sign out</button></form>
      </div>
    </aside>
    <div class="shell-main">
      <main class="container">
        {{template "content" .}}
      </main>
    </div>
  </div>
  {{end}}
  <script>
    // (i) field hints: reveal the bubble on hover/focus and position it with
    // fixed coordinates so it is never clipped by a modal, a scroll container,
    // or the viewport edge. Flips below the icon when there is no room above.
    (function () {
      function show(hint) {
        var bub = hint.querySelector('.hint-bub');
        if (!bub) return;
        bub.style.visibility = 'hidden';
        bub.style.display = 'block';
        var r = hint.getBoundingClientRect();
        var bw = bub.offsetWidth, bh = bub.offsetHeight, m = 8;
        var left = Math.min(Math.max(m, r.left + r.width / 2 - bw / 2), window.innerWidth - bw - m);
        var top = r.top - bh - 6;
        if (top < m) top = r.bottom + 6;
        bub.style.left = left + 'px';
        bub.style.top = top + 'px';
        bub.style.visibility = 'visible';
      }
      function hide(hint) {
        var bub = hint.querySelector('.hint-bub');
        if (bub) { bub.style.display = 'none'; bub.style.visibility = ''; }
      }
      document.addEventListener('mouseover', function (e) {
        var h = e.target.closest && e.target.closest('.hint'); if (h) show(h);
      });
      document.addEventListener('mouseout', function (e) {
        var h = e.target.closest && e.target.closest('.hint');
        if (h && !h.contains(e.relatedTarget)) hide(h);
      });
      document.addEventListener('focusin', function (e) {
        var h = e.target.closest && e.target.closest('.hint'); if (h) show(h);
      });
      document.addEventListener('focusout', function (e) {
        var h = e.target.closest && e.target.closest('.hint'); if (h) hide(h);
      });
    })();
  </script>
</body>
</html>{{end}}
