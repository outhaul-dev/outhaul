{{define "brandmark"}}<svg class="brand-mark" viewBox="0 0 100 100" fill="none" stroke-width="9" stroke-linecap="round"><circle cx="30" cy="50" r="19" stroke="var(--text-primary)"/><line x1="86" y1="30" x2="86" y2="70" stroke="var(--text-primary)" stroke-linecap="square"/><line x1="49" y1="50" x2="82" y2="50" stroke="var(--accent)"/></svg>{{end}}
{{define "base"}}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{if .Title}}{{.Title}} · {{end}}Outhaul</title>
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/htmx.min.js" defer></script>
</head>
<body>
  {{if .HideChrome}}
  <main class="container">
    {{template "content" .}}
  </main>
  {{else}}
  <div class="shell">
    <aside class="sidebar">
      <a class="sidebar-brand" href="/">{{template "brandmark" .}}<span class="brand-word">out<span class="haul">haul</span></span></a>
      <nav class="sidebar-nav">
        <div class="nav-group">
          <a class="nav-item {{if eq .Active "overview"}}active{{end}}" href="/"><svg class="nav-ico" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg><span class="nav-label">Overview</span></a>
        </div>
        <div class="nav-group">
          <div class="nav-group-label">Deploy</div>
          <a class="nav-item {{if eq .Active "projects"}}active{{end}}" href="/projects"><svg class="nav-ico" viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h3.5l2 2H19a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg><span class="nav-label">Projects</span></a>
          <a class="nav-item {{if eq .Active "apps"}}active{{end}}" href="/apps"><svg class="nav-ico" viewBox="0 0 24 24"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5"/><path d="M12 12v9"/></svg><span class="nav-label">Apps</span></a>
          <a class="nav-item {{if eq .Active "templates"}}active{{end}}" href="/templates"><svg class="nav-ico" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="7" rx="1"/><rect x="3" y="13" width="9" height="8" rx="1"/><rect x="15" y="13" width="6" height="8" rx="1"/></svg><span class="nav-label">Templates</span></a>
          <a class="nav-item {{if eq .Active "containers"}}active{{end}}" href="/containers"><svg class="nav-ico" viewBox="0 0 24 24"><path d="M12 2 3 7l9 5 9-5z"/><path d="M3 12l9 5 9-5"/><path d="M3 17l9 5 9-5"/></svg><span class="nav-label">Containers</span></a>
        </div>
        <div class="nav-group">
          <div class="nav-group-label">Resources</div>
          <a class="nav-item {{if eq .Active "databases"}}active{{end}}" href="/databases"><svg class="nav-ico" viewBox="0 0 24 24"><ellipse cx="12" cy="5.5" rx="8" ry="3"/><path d="M4 5.5v13c0 1.66 3.58 3 8 3s8-1.34 8-3v-13"/><path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/></svg><span class="nav-label">Databases</span></a>
          <a class="nav-item {{if eq .Active "volumes"}}active{{end}}" href="/volumes"><svg class="nav-ico" viewBox="0 0 24 24"><path d="M5.5 5h13a2 2 0 0 1 1.8 1.1L22 11v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6l1.7-4.9A2 2 0 0 1 5.5 5z"/><path d="M2 11h20"/><path d="M6.5 15h.01"/></svg><span class="nav-label">Volumes</span></a>
          <a class="nav-item {{if eq .Active "registry"}}active{{end}}" href="/registry"><svg class="nav-ico" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8"/><path d="M10 12h4"/></svg><span class="nav-label">Registry</span> <span class="soon">soon</span></a>
          <a class="nav-item {{if eq .Active "domains"}}active{{end}}" href="/domains"><svg class="nav-ico" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.5 3.8 5.7 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.7-3.8-9S9.5 5.5 12 3z"/></svg><span class="nav-label">Domains</span></a>
        </div>
        <div class="nav-group">
          <div class="nav-group-label">System</div>
          <a class="nav-item {{if eq .Active "metrics"}}active{{end}}" href="/metrics"><svg class="nav-ico" viewBox="0 0 24 24"><path d="M3 12h3.5l2.5 7 4-15 2.5 8H21"/></svg><span class="nav-label">Metrics</span></a>
        </div>
      </nav>
      <div class="sidebar-foot">
        <a class="nav-item {{if eq .Active "settings"}}active{{end}}" href="/settings"><svg class="nav-ico" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg><span class="nav-label">Settings</span></a>
        <form method="post" action="/logout" class="inline"><button type="submit" class="nav-item linkbtn"><svg class="nav-ico" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg><span class="nav-label">Sign out</span></button></form>
      </div>
    </aside>
    <div class="shell-main">
      <main class="container">
        {{template "content" .}}
      </main>
    </div>
  </div>
  {{end}}
  <script>
    // (i) field hints: reveal the bubble on hover/focus and position it with
    // fixed coordinates so it is never clipped by a modal, a scroll container,
    // or the viewport edge. Flips below the icon when there is no room above.
    (function () {
      function show(hint) {
        var bub = hint.querySelector('.hint-bub');
        if (!bub) return;
        bub.style.visibility = 'hidden';
        bub.style.display = 'block';
        var r = hint.getBoundingClientRect();
        var bw = bub.offsetWidth, bh = bub.offsetHeight, m = 8;
        var left = Math.min(Math.max(m, r.left + r.width / 2 - bw / 2), window.innerWidth - bw - m);
        var top = r.top - bh - 6;
        if (top < m) top = r.bottom + 6;
        bub.style.left = left + 'px';
        bub.style.top = top + 'px';
        bub.style.visibility = 'visible';
      }
      function hide(hint) {
        var bub = hint.querySelector('.hint-bub');
        if (bub) { bub.style.display = 'none'; bub.style.visibility = ''; }
      }
      document.addEventListener('mouseover', function (e) {
        var h = e.target.closest && e.target.closest('.hint'); if (h) show(h);
      });
      document.addEventListener('mouseout', function (e) {
        var h = e.target.closest && e.target.closest('.hint');
        if (h && !h.contains(e.relatedTarget)) hide(h);
      });
      document.addEventListener('focusin', function (e) {
        var h = e.target.closest && e.target.closest('.hint'); if (h) show(h);
      });
      document.addEventListener('focusout', function (e) {
        var h = e.target.closest && e.target.closest('.hint'); if (h) hide(h);
      });
    })();
  </script>
</body>
</html>{{end}}
