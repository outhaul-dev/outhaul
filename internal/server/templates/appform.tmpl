{{define "appform"}}
<section class="panel">
  <h2 class="panel-title">New app</h2>
  {{if .Projects}}
  <form method="post" action="/apps" class="grid-form">
    {{if .Return}}<input type="hidden" name="return" value="{{.Return}}">{{end}}
    <label class="field">
      <span>Name</span>
      <input type="text" name="name" placeholder="web" value="{{with .Form}}{{.Name}}{{end}}" required>
    </label>
    <label class="field">
      <span>Project</span>
      <select name="project_id">
        {{range .Projects}}<option value="{{.ID}}"{{if eq .ID $.SelectedProject}} selected{{end}}>{{.Name}}</option>{{end}}
      </select>
    </label>
    <label class="field">
      <span>Deploy</span>
      <select name="kind" id="kind-select">
        <option value="nixpacks">Nixpacks build (single service)</option>
        <option value="compose">Docker Compose (multi-service stack)</option>
      </select>
    </label>
    <label class="field">
      <span>Source</span>
      <select name="source" id="source-select">
        <option value="public">Public Git URL</option>
        <option value="ssh">Private (SSH deploy key)</option>
        {{if .GithubConnected}}<option value="github">GitHub App</option>{{end}}
      </select>
    </label>
    {{if .GithubConnected}}
    <label class="field" data-source="github">
      <span>GitHub repository</span>
      <select name="github_repo">
        {{range .GithubRepos}}<option value="{{.FullName}}">{{.FullName}}</option>{{end}}
      </select>
    </label>
    {{end}}
    <label class="field" data-source="public ssh">
      <span>Git URL</span>
      <input type="text" name="repo_url" placeholder="https://github.com/owner/repo.git" value="{{with .Form}}{{.RepoURL}}{{end}}">
    </label>
    <label class="field">
      <span>Branch</span>
      <input type="text" name="branch" placeholder="main" value="main">
    </label>
    <label class="field" data-kind="compose" hidden>
      <span>Compose file</span>
      <input type="text" name="compose_path" placeholder="docker-compose.yml">
    </label>
    <label class="field">
      <span>Domain</span>
      <input type="text" name="domain" id="domain-input" placeholder="web.example.com" value="{{with .Form}}{{.Domain}}{{end}}" required>
    </label>
    <label class="field" data-kind="compose" hidden>
      <span>Expose service</span>
      <input type="text" name="compose_service" placeholder="web">
    </label>
    <label class="field" data-kind="compose" hidden>
      <span>Service port</span>
      <input type="text" name="compose_port" placeholder="3000" inputmode="numeric">
    </label>
    <label class="field-check">
      <input type="checkbox" name="auto_deploy"> <span>Auto-deploy on push</span>
    </label>
    <button type="submit" class="btn btn-primary">Create app</button>
  </form>
  <p class="muted env-note" data-kind="compose" hidden>Domain, service and port publish one stack service (leave the domain blank for an internal-only stack). More domains can be added on the app page after creating it.</p>
  <script>
    // Progressive enhancement: reveal the compose fields only for compose
    // apps, where Domain becomes optional (leave it blank for an
    // internal-only stack). Without JS everything shows; the server
    // validates either way.
    (function () {
      var kind = document.getElementById('kind-select');
      if (!kind) return;
      var apply = function () {
        var isCompose = kind.value === 'compose';
        document.querySelectorAll('[data-kind="compose"]').forEach(function (el) {
          el.hidden = !isCompose;
        });
        document.getElementById('domain-input').required = !isCompose;
      };
      kind.addEventListener('change', apply);
      apply();
    })();
  </script>
  {{if not .GithubConnected}}<p class="env-note"><a href="/github/connect">Connect a GitHub App</a> to deploy private GitHub repos and auto-deploy on push.</p>{{end}}
  {{else}}
  <p class="empty">No projects yet. <a href="/projects">Create a project</a> first, then add apps to it.</p>
  {{end}}
</section>
{{end}}
