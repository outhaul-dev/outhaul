{{define "content"}}
<div class="pagehead">
  <div>
    <div class="crumbs"><a href="/projects">Projects</a> / {{if .Project.ID}}<a href="/projects/{{.Project.ID}}">{{.Project.Name}}</a> / {{end}}<a href="/apps/{{.App.ID}}">{{.App.Name}}</a> / #{{.Deployment.ID}}</div>
    <h1>Deployment #{{.Deployment.ID}} <span class="badge {{stateClass .Deployment.Status}}" id="status-badge">{{.Deployment.Status}}</span>{{if .Deployment.RollbackOf}} <span class="muted h1-note">↩ rollback of #{{.Deployment.RollbackOf}}</span>{{end}}</h1>
  </div>
  {{if .Deployment.Status.CanCancel}}
  <form method="post" action="/deployments/{{.Deployment.ID}}/cancel" class="inline">
    <button type="submit" class="btn btn-danger">Cancel</button>
  </form>
  {{else if and .Deployment.Status.IsTerminal .Deployment.Image (ne .App.Kind "compose")}}
  {{if .Deployment.ImagePruned}}
  <span class="muted" title="the built image was removed by image retention; deploy to rebuild from the branch">image pruned</span>
  {{else}}
  <form method="post" action="/deployments/{{.Deployment.ID}}/rollback" class="inline" onsubmit="return confirm('Roll back {{.App.Name}} to the image built by deployment #{{.Deployment.ID}}? Current env vars and domain settings will apply.');">
    <button type="submit" class="btn btn-quiet">Rollback to this deployment</button>
  </form>
  {{end}}
  {{end}}
</div>

{{if .Deployment.Reason}}<div class="alert alert-error">{{.Deployment.Reason}}</div>{{end}}

<section class="panel">
  <div class="log-head">
    <h2 class="panel-title">Build &amp; deploy log</h2>
    <span class="log-status" id="stream-indicator">{{if .Live}}streaming…{{else}}complete{{end}}</span>
  </div>
  <pre class="log" id="log" data-id="{{.Deployment.ID}}" data-live="{{.Live}}"></pre>
</section>

<script>
(function () {
  var el = document.getElementById('log');
  var indicator = document.getElementById('stream-indicator');
  var id = el.getAttribute('data-id');
  var live = el.getAttribute('data-live') === 'true';

  var received = 0;
  var es = new EventSource('/deployments/' + id + '/logs');

  es.addEventListener('log', function (e) {
    received++;
    var atBottom = (el.scrollTop + el.clientHeight) >= (el.scrollHeight - 4);
    el.textContent += e.data + '\n';
    if (atBottom) { el.scrollTop = el.scrollHeight; }
  });

  es.addEventListener('done', function () {
    es.close();
    if (live) {
      // The deployment finished while we were watching; reload to show the
      // final status and reason.
      window.location.reload();
      return;
    }
    if (indicator) { indicator.textContent = 'complete'; }
    if (received === 0) {
      // Build logs live in memory only, so an older deployment (or anything
      // from before the last restart) replays nothing. Say so rather than
      // leaving a bare empty box.
      el.classList.add('log-empty');
      el.textContent = 'Build logs for this deployment are no longer available. They are kept in memory only and cleared when the service restarts.';
      if (indicator) { indicator.textContent = 'no logs'; }
    }
  });

  es.onerror = function () {
    if (indicator) { indicator.textContent = 'disconnected'; }
  };
})();
</script>
{{end}}
