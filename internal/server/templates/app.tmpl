{{define "content"}}
<div class="pagehead">
  <div>
    <div class="crumbs"><a href="/projects">Projects</a> / {{with .Project}}<a href="/projects/{{.ID}}">{{.Name}}</a> / {{end}}{{.App.Name}}</div>
    <h1>{{.App.Name}}{{if .App.TemplateID}} <span class="badge">Template</span>{{else if eq .App.Kind "compose"}} <span class="badge">Compose</span>{{else if eq .App.Kind "dockerfile"}} <span class="badge">Dockerfile</span>{{end}}</h1>
  </div>
  <div class="pagehead-actions">
    <span class="badge state-{{if eq .Runtime "running"}}running{{else}}stopped{{end}}">{{.Runtime}}</span>
    <form method="post" action="/apps/{{.App.ID}}/deploy" class="inline"><button type="submit" class="btn btn-primary">Deploy</button></form>
    <form method="post" action="/apps/{{.App.ID}}/stop" class="inline"><button type="submit" class="btn">Stop</button></form>
    <form method="post" action="/apps/{{.App.ID}}/restart" class="inline"><button type="submit" class="btn">Restart</button></form>
  </div>
</div>

<nav class="tabs" id="app-tabs">
  <a href="#overview" data-tab-link="overview">Overview</a>
  <a href="#deployments" data-tab-link="deployments">Deployments</a>
  <a href="#networking" data-tab-link="networking">Networking</a>
  <a href="#resources" data-tab-link="resources">Resources</a>
  <a href="#settings" data-tab-link="settings">Settings</a>
</nav>

<section class="tab" data-tab="overview">
<section class="panel">
  <dl class="meta">
    {{if eq .App.Kind "compose"}}
    <div><dt>Domains</dt><dd>{{if .Domains}}{{range .Domains}}<div><a href="http://{{.Host}}" target="_blank" rel="noreferrer" class="mono">{{.Host}}</a> <span class="muted mono">→ {{.Service}}:{{.Port}}</span></div>{{end}}{{else}}<span class="muted">— internal only</span>{{end}}</dd></div>
    {{else}}
    <div><dt>Domain</dt><dd>{{if .App.Domain}}<a href="http://{{.App.Domain}}" target="_blank" rel="noreferrer" class="mono">{{.App.Domain}}</a>{{else}}<span class="muted">— internal only</span>{{end}}</dd></div>
    {{end}}
    {{if .App.TemplateID}}
    <div><dt>Template</dt><dd class="mono">{{.App.TemplateID}}</dd></div>
    {{else}}
    <div><dt>Repository</dt><dd class="mono">{{.App.RepoURL}}</dd></div>
    {{if eq .App.Kind "compose"}}<div><dt>Compose file</dt><dd class="mono">{{.App.ComposePath}}</dd></div>{{end}}
    {{end}}
    <div><dt>Build type</dt><dd class="mono">{{.App.Kind}}</dd></div>
    {{if not .App.TemplateID}}<div><dt>Branch</dt><dd class="mono">{{.App.Branch}}</dd></div>{{end}}
    {{if .Deployments}}<div><dt>Last deployed</dt><dd class="mono muted">{{with index .Deployments 0}}<time datetime="{{.CreatedAt.Format "2006-01-02T15:04:05Z07:00"}}" title="{{fmtTime .CreatedAt}}">{{fmtTime .CreatedAt}}</time>{{end}}</dd></div>{{end}}
  </dl>
</section>

<section class="panel">
  <div class="log-head">
    <h2 class="panel-title">Metrics</h2>
    <span class="log-status" id="metrics-indicator">connecting…</span>
  </div>
  <div class="stats">
    <div class="stat"><div class="stat-label">CPU</div><div class="stat-value" id="metric-cpu">—<span class="unit">%</span></div><div class="stat-sub">100% = one core</div></div>
    <div class="stat"><div class="stat-label">Memory</div><div class="stat-value" id="metric-mem">—</div><div class="stat-sub" id="metric-mem-sub">usage</div></div>
    <div class="stat"><div class="stat-label">Net I/O</div><div class="stat-value" id="metric-net">—</div><div class="stat-sub">received · sent, total</div></div>
    <div class="stat"><div class="stat-label">Uptime</div><div class="stat-value" id="metric-uptime">—</div><div class="stat-sub">since container start</div></div>
  </div>
</section>

<script>
(function () {
  var indicator = document.getElementById('metrics-indicator');
  var cpu = document.getElementById('metric-cpu');
  var mem = document.getElementById('metric-mem');
  var memSub = document.getElementById('metric-mem-sub');
  var net = document.getElementById('metric-net');
  var uptime = document.getElementById('metric-uptime');

  function dashes() {
    cpu.innerHTML = '—<span class="unit">%</span>';
    mem.textContent = '—';
    memSub.textContent = 'usage';
    net.textContent = '—';
    uptime.textContent = '—';
  }

  function poll() {
    fetch('/apps/{{.App.ID}}/stats', {headers: {'Accept': 'application/json'}})
      .then(function (r) { if (!r.ok) { throw new Error(r.status); } return r.json(); })
      .then(function (s) {
        if (!s.running) { dashes(); indicator.textContent = 'not running'; return; }
        cpu.innerHTML = '';
        cpu.appendChild(document.createTextNode(s.cpu));
        var u = document.createElement('span'); u.className = 'unit'; u.textContent = '%';
        cpu.appendChild(u);
        mem.textContent = s.mem;
        memSub.textContent = s.memSub || 'usage';
        net.textContent = s.net;
        uptime.textContent = s.uptime || '—';
        indicator.textContent = s.containers > 1 ? 'live · ' + s.containers + ' containers' : 'live';
      })
      .catch(function () { dashes(); indicator.textContent = 'unavailable'; });
  }

  poll();
  setInterval(poll, 5000);
})();
</script>

<section class="panel">
  <div class="log-head">
    <h2 class="panel-title">Runtime logs</h2>
    <div class="log-controls">
      {{if and (eq .App.Kind "compose") .Stack}}
      <select id="log-service" title="Compose service">
        {{range .Stack}}<option value="{{.Service}}">{{.Service}}</option>{{end}}
      </select>
      {{end}}
      <select id="log-tail" title="Lines to tail">
        <option value="100">100 lines</option>
        <option value="500">500 lines</option>
        <option value="1000">1000 lines</option>
        <option value="5000">5000 lines</option>
      </select>
      <span class="log-status" id="runtime-indicator">connecting…</span>
    </div>
  </div>
  <pre class="log" id="runtime-log" data-id="{{.App.ID}}"></pre>
</section>

<script>
(function () {
  var el = document.getElementById('runtime-log');
  var indicator = document.getElementById('runtime-indicator');
  var svcSel = document.getElementById('log-service');
  var tailSel = document.getElementById('log-tail');
  var id = el.getAttribute('data-id');
  var es = null;

  function open() {
    if (es) { es.close(); }
    el.textContent = '';
    indicator.textContent = 'connecting…';
    var qs = 'tail=' + tailSel.value;
    if (svcSel) { qs += '&service=' + encodeURIComponent(svcSel.value); }
    es = new EventSource('/apps/' + id + '/logs?' + qs);
    es.onopen = function () { indicator.textContent = 'streaming…'; };
    es.addEventListener('log', function (e) {
      var atBottom = (el.scrollTop + el.clientHeight) >= (el.scrollHeight - 4);
      el.textContent += e.data + '\n';
      if (atBottom) { el.scrollTop = el.scrollHeight; }
    });
    es.addEventListener('err', function (e) {
      es.close();
      el.textContent = e.data;
      indicator.textContent = 'unavailable';
    });
    es.addEventListener('done', function () {
      es.close();
      indicator.textContent = 'stopped';
    });
    es.onerror = function () { indicator.textContent = 'disconnected'; };
  }

  if (svcSel) { svcSel.addEventListener('change', open); }
  tailSel.addEventListener('change', open);
  open();
})();
</script>
</section>

<section class="tab" data-tab="deployments">
{{if .PushRemote}}
<section class="panel">
  <h2 class="panel-title">Deploy with git push</h2>
  <p class="muted">Add this remote once, then push to deploy — the build streams into your terminal.</p>
  <div class="copywrap"><pre class="mono">git remote add outhaul {{.PushRemote}}
git push outhaul {{.PushBranch}}</pre>{{template "copybtn" .}}</div>
  <p class="muted env-note">Your push key must be registered under <a href="/settings">Settings → Push keys</a>, and the SSH port must be reachable from your machine.</p>
</section>
{{end}}

<section class="panel">
  <h2 class="panel-title">Deployments</h2>
  {{if .Deployments}}
  <table class="table">
    <thead>
      <tr><th>#</th><th>Status</th><th>Created</th><th>Build</th><th></th></tr>
    </thead>
    <tbody>
      {{range .Deployments}}
      <tr>
        <td class="mono">{{.ID}}{{if .RollbackOf}} <span class="muted" title="reused the image built by deployment #{{.RollbackOf}}">↩ #{{.RollbackOf}}</span>{{end}}</td>
        <td>
          {{if isStatus .Status "running"}}
            {{if eq .ID $.LiveDeploymentID}}<span class="badge state-running">live</span>
            {{else}}<span class="badge state-stopped">superseded</span>{{end}}
          {{else}}
            <span class="badge {{stateClass .Status}}">{{.Status}}</span>
          {{end}}
        </td>
        <td class="mono muted"><time datetime="{{.CreatedAt.Format "2006-01-02T15:04:05Z07:00"}}" title="{{fmtTime .CreatedAt}}">{{fmtTime .CreatedAt}}</time></td>
        <td class="mono muted">{{buildDur .}}</td>
        <td class="row-actions">
          {{if and .Status.IsTerminal .Image (ne $.App.Kind "compose")}}
          {{if .ImagePruned}}
          <span class="muted" title="the built image was removed by image retention; deploy to rebuild from the branch">image pruned</span>
          {{else}}
          <form method="post" action="/deployments/{{.ID}}/rollback" class="inline" onsubmit="return confirm('Roll back {{$.App.Name}} to the image built by deployment #{{.ID}}? Current env vars and domain settings will apply.');">
            <button type="submit" class="btn btn-quiet">Rollback</button>
          </form>
          {{end}}
          {{end}}
          <a href="/deployments/{{.ID}}" class="rowlink">logs →</a>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="empty">No deployments yet. Click <strong>Deploy</strong> to build and launch this app.</p>
  {{end}}
<script>
(function () {
  function rel(d) {
    var s = Math.floor((Date.now() - d.getTime()) / 1000);
    if (s < 45) return 'just now';
    var m = Math.floor(s / 60); if (m < 60) return m + 'm ago';
    var h = Math.floor(m / 60); if (h < 24) return h + 'h ago';
    var days = Math.floor(h / 24); if (days < 30) return days + 'd ago';
    var mo = Math.floor(days / 30); if (mo < 12) return mo + 'mo ago';
    return Math.floor(mo / 12) + 'y ago';
  }
  document.querySelectorAll('time[datetime]').forEach(function (el) {
    var d = new Date(el.getAttribute('datetime'));
    if (!isNaN(d.getTime())) el.textContent = rel(d);
  });
})();
</script>
</section>
</section>

<section class="tab" data-tab="networking">
<section class="panel">
  <div class="log-head">
    <h2 class="panel-title">Domains</h2>
    <button type="button" class="btn btn-primary" onclick="openDomainDialog()">+ New domain</button>
  </div>
  {{if .Domains}}
  <table class="table">
    <thead><tr><th>Domain</th>{{if eq .App.Kind "compose"}}<th>Service</th>{{end}}<th>Port</th><th>Path</th><th>HTTPS</th><th></th></tr></thead>
    <tbody>
      {{range .Domains}}
      <tr>
        <td><a href="http{{if .TLS}}s{{end}}://{{.Host}}{{.Path}}" target="_blank" rel="noreferrer" class="mono">{{.Host}}{{.Path}}</a></td>
        {{if eq $.App.Kind "compose"}}<td class="mono">{{.Service}}</td>{{end}}
        <td class="mono">{{.Port}}</td>
        <td class="mono muted">{{if .Path}}{{.Path}}{{if .InternalPath}} &rarr; {{.InternalPath}}{{end}}{{else}}/{{end}}</td>
        <td>{{if .TLS}}<span class="badge state-running">TLS</span>{{else}}<span class="muted">http</span>{{end}}</td>
        <td>
          <button type="button" class="linkbtn"
            onclick='openDomainDialog({"id":"{{.ID}}","host":"{{.Host}}","service":"{{.Service}}","port":"{{.Port}}","path":"{{.Path}}","internal_path":"{{.InternalPath}}","tls":"{{if .TLS}}1{{else}}0{{end}}"})'>edit</button>
          <form method="post" action="/apps/{{$.App.ID}}/domains/{{.ID}}/delete" class="inline" onsubmit="return confirm('Remove {{.Host}}{{.Path}}?');">
            <button type="submit" class="linkbtn">remove</button>
          </form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="empty">No domains yet — this app is internal-only until you add one.</p>
  {{end}}
  <p class="muted env-note">Domain changes apply on this app's next deploy.</p>
</section>

{{template "domainform" .}}
</section>

<section class="tab" data-tab="resources">
{{if eq .App.Kind "compose"}}
<section class="panel">
  <h2 class="panel-title">Services</h2>
  {{if .Stack}}
  <table class="table">
    <thead><tr><th>Service</th><th>State</th></tr></thead>
    <tbody>
      {{range .Stack}}
      <tr>
        <td class="mono">{{.Service}}</td>
        <td><span class="badge state-{{if eq .State "running"}}running{{else}}stopped{{end}}">{{.State}}</span></td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="empty">No stack containers yet. Deploy to bring the stack up.</p>
  {{end}}
</section>

{{template "backups" .}}
{{end}}

{{if ne .App.Kind "compose"}}
<section class="panel">
  <div class="log-head">
    <h2 class="panel-title">Volumes</h2>
    <button type="button" class="btn btn-primary" onclick="openVolumeDialog()">+ Add volume</button>
  </div>
  {{if .Volumes}}
  <table class="table">
    <thead><tr><th>Mount path</th><th>Docker volume</th><th></th></tr></thead>
    <tbody>
      {{range .Volumes}}
      <tr>
        <td class="mono">{{.MountPath}}</td>
        <td class="mono muted">{{.Name}}</td>
        <td>
          <button type="button" class="linkbtn"
            onclick='openVolumeDialog({"id":"{{.ID}}","mount_path":"{{.MountPath}}"})'>edit</button>
          <form method="post" action="/apps/{{$.App.ID}}/volumes/{{.ID}}/delete" class="inline" onsubmit="return confirm('Detach the volume at {{.MountPath}}? The data is kept.');">
            <button type="submit" class="linkbtn">detach</button>
          </form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="empty">No volumes. This app is stateless until you attach one — data written outside a volume is lost on the next deploy.</p>
  {{end}}
  <p class="muted env-note">Volume changes apply on this app's next deploy. Detaching keeps the underlying data — reclaim it later from the <a href="/volumes">Volumes</a> tab.</p>
</section>

{{template "volumeform" .}}

{{/* Backups panel: shown once the handler supplies its data — a single-container
     app gets it while it has a volume, or while a schedule still exists. */}}
{{if .BackupKind}}
{{template "backups" .}}
{{end}}
{{end}}

<section class="panel">
  <h2 class="panel-title">Databases</h2>
  {{if .Attachments}}
  <table class="table">
    <thead><tr><th>Env var</th><th>Database</th><th></th></tr></thead>
    <tbody>
      {{range .Attachments}}
      <tr>
        <td class="mono">{{.EnvVar}}</td>
        <td class="mono muted">{{.DBName}}</td>
        <td>
          <form method="post" action="/apps/{{$.App.ID}}/attachments/{{.ID}}/delete" class="inline">
            <button type="submit" class="linkbtn">detach</button>
          </form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="empty">No databases attached. Attaching one injects its connection URL as an env var at deploy time.</p>
  {{end}}
  {{if .ProjDatabases}}
  <form method="post" action="/apps/{{.App.ID}}/attachments" class="grid-form env-add">
    <label class="field"><span>Database</span>
      <select name="database_id" required>
        {{range .ProjDatabases}}<option value="{{.ID}}">{{.Name}} ({{.Engine}})</option>{{end}}
      </select>
    </label>
    <label class="field"><span>Env var</span><input type="text" name="env_var" value="DATABASE_URL" required></label>
    <button type="submit" class="btn btn-primary">Attach</button>
  </form>
  {{else}}
  <p class="muted env-note">Create a database in this project to attach it here.</p>
  {{end}}
</section>

{{if .PreviewsAvailable}}
<section class="panel">
  <h2 class="panel-title">Preview environments {{template "hint" "Give each open pull request its own throwaway copy of this app — a fresh isolated deploy (with its own copies of any attached databases), torn down automatically when the PR closes or goes idle."}}</h2>
  <p class="muted">Spin up an ephemeral copy of this app for each open pull request, torn down when the PR closes.</p>
  <form method="post" action="/apps/{{.App.ID}}/previews" class="grid-form">
    <label class="field-check"><input type="checkbox" name="enabled" {{if .PreviewConfig.Enabled}}checked{{end}}> <span>Enabled {{template "hint" "Turn preview environments on for this app. When off, pull requests are ignored."}}</span></label>
    <label class="field"><span>Base domain {{template "hint" "Preview hostnames are built under this domain (e.g. pr-42.preview.example.com). Leave blank to use generated sslip.io hostnames that need no DNS."}}</span><input type="text" name="base_domain" value="{{.PreviewConfig.BaseDomain}}" placeholder="preview.example.com"></label>
    <label class="field"><span>Idle TTL (days) {{template "hint" "How many days a preview can sit with no new deploy before it is automatically torn down."}}</span><input type="number" name="idle_ttl_days" min="1" value="{{.PreviewConfig.IdleTTLDays}}"></label>
    <label class="field"><span>Max concurrent {{template "hint" "The most previews allowed live at once for this app. Additional pull requests wait until a slot frees up."}}</span><input type="number" name="max_concurrent" min="1" value="{{.PreviewConfig.MaxConcurrent}}"></label>
    <label class="field-check"><input type="checkbox" name="post_pr_comment" {{if .PreviewConfig.PostPRComment}}checked{{end}}> <span>Post PR comment {{template "hint" "Post and keep-updated a status comment on the pull request with the preview URL and build state."}}</span></label>
    <label class="field-check"><input type="checkbox" name="allow_fork_prs" {{if .PreviewConfig.AllowForkPRs}}checked{{end}}> <span>Allow fork PRs {{template "hint" "Also build previews for pull requests opened from forks. Off by default: fork code would run with this app's secrets."}}</span></label>
    <button type="submit" class="btn btn-primary">Save</button>
  </form>
  <p class="muted env-note">Leave the base domain blank to use generated sslip.io hostnames.</p>
  {{if .Previews}}
  <table class="table">
    <thead><tr><th>PR</th><th>Status</th><th>URL</th><th></th></tr></thead>
    <tbody>
      {{range .Previews}}
      <tr>
        <td class="mono">#{{.PR}}</td>
        <td><span class="badge state-{{if eq .Status "ready"}}running{{else if eq .Status "building"}}building{{else}}stopped{{end}}">{{.Status}}</span></td>
        <td>{{if .URL}}<a href="{{.URL}}" target="_blank" rel="noreferrer" class="mono">{{.URL}}</a>{{else}}<span class="muted">— internal only</span>{{end}}</td>
        <td>
          <form method="post" action="/apps/{{$.App.ID}}/previews/{{.ID}}/destroy" class="inline" onsubmit="return confirm('Destroy the preview for PR #{{.PR}}?');">
            <button type="submit" class="linkbtn">destroy</button>
          </form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="empty">No active previews. Open a pull request to spin one up.</p>
  {{end}}
</section>
{{end}}
</section>

<section class="tab" data-tab="settings">
{{if not .App.TemplateID}}
<section class="panel">
  <h2 class="panel-title">Deploy settings</h2>
  <form method="post" action="/apps/{{.App.ID}}/settings" class="grid-form">
    <label class="field"><span>Branch {{template "hint" "The Git branch to deploy. Changing this affects the next deploy."}}</span><input type="text" name="branch" value="{{.App.Branch}}"></label>
    {{if eq .App.Kind "compose"}}
    <label class="field"><span>Compose file {{template "hint" "Path to the docker-compose file within the repo. Defaults to ./docker-compose.yml."}}</span><input type="text" name="compose_path" value="{{.App.ComposePath}}"></label>
    {{end}}
    {{if eq .App.Kind "dockerfile"}}
    <label class="field"><span>Dockerfile {{template "hint" "Path to the Dockerfile within the repo, relative to its root. Defaults to ./Dockerfile."}}</span><input type="text" name="dockerfile_path" value="{{.App.DockerfilePath}}"></label>
    {{end}}
    <label class="field-check"><input type="checkbox" name="auto_deploy" {{if .App.AutoDeploy}}checked{{end}}> <span>Auto-deploy on push {{template "hint" "Redeploy automatically whenever you push to this branch (GitHub App source only)."}}</span></label>
    <label class="field field-wide">
      <span>Watch paths</span>
      <textarea name="watch_paths" rows="3" placeholder="src/**&#10;package.json">{{joinLines .App.WatchPaths}}</textarea>
    </label>
    <button type="submit" class="btn">Save</button>
  </form>
  <p class="muted env-note">Watch paths: one glob per line (<span class="mono">*</span> within a folder, <span class="mono">**</span> across folders). When set, a push only auto-deploys if it changed a matching file; leave empty to deploy on every push to the branch.</p>
</section>

<section class="panel">
  <div class="log-head"><h2 class="panel-title">Source &amp; build {{template "hint" "Change where this app's code comes from and how it is built. Changes take effect on the next deploy."}}</h2></div>

  <form method="post" action="/apps/{{.App.ID}}/source" class="grid-form">
    <label class="field"><span>Source {{template "hint" "Public Git URL needs no credentials; SSH uses a generated deploy key; Push hosts the repo in Outhaul; GitHub App lets you pick a connected repo."}}</span>
      <select name="source" id="src-source-select">
        <option value="public" {{if eq .App.Source "public"}}selected{{end}}>Public Git URL</option>
        <option value="ssh" {{if eq .App.Source "ssh"}}selected{{end}}>Private (SSH deploy key)</option>
        <option value="push" {{if eq .App.Source "push"}}selected{{end}}>Push to deploy (git push)</option>
        {{if or .GitSourceConnected (eq .App.Source "github")}}<option value="github" {{if eq .App.Source "github"}}selected{{end}}>GitHub App{{if not .GitSourceConnected}} (reconnect required){{end}}</option>{{end}}
      </select>
    </label>
    {{if or .RepoGroups .CurrentRepoUnlisted}}
    <label class="field" data-src="github"><span>Repository</span>
      <input type="text" id="src-repo-filter" placeholder="filter repos…" autocomplete="off">
      <select name="github_repo" id="src-github-repo" size="8">
        {{if .CurrentRepoUnlisted}}
        <optgroup label="{{.CurrentRepoLabel}}">
          <option value="{{.App.GithubRepo}}" data-source-id="{{.App.GitSourceID}}" selected>{{.App.GithubRepo}}</option>
        </optgroup>
        {{end}}
        {{range .RepoGroups}}{{$group := .}}
        <optgroup label="{{.AccountLogin}}{{if .AccountKind}} ({{.AccountKind}}){{end}}">
          {{range .Repos}}<option value="{{.FullName}}" data-source-id="{{$group.SourceID}}"{{if and (eq .FullName $.App.GithubRepo) (eq $group.SourceID $.App.GitSourceID)}} selected{{end}}>{{.FullName}}</option>{{end}}
        </optgroup>
        {{end}}
      </select>
      <input type="hidden" name="git_source_id" id="src-git-source-id" value="{{.App.GitSourceID}}">
    </label>
    {{end}}
    <label class="field" data-src="public ssh"><span>Git URL {{template "hint" "The clone URL of your repository. Use an https URL for a public repo or an ssh URL (git@host:owner/repo.git) for SSH."}}</span>
      <input type="text" name="repo_url" value="{{if ne .App.Source "github"}}{{.App.RepoURL}}{{end}}" placeholder="https://github.com/owner/repo.git">
    </label>
    <button type="submit" class="btn">Change source</button>
  </form>
  <p class="muted env-note">Switching to SSH issues a new deploy key (shown below after saving) — the previous key stops working. GitHub source needs the GitHub App installed. Changes apply on the next deploy.</p>

  <form method="post" action="/apps/{{.App.ID}}/kind" class="grid-form" onsubmit="return confirmKindChange(this)">
    <label class="field"><span>Build type {{template "hint" "Nixpacks auto-detects your language; Dockerfile builds from a Dockerfile; Compose runs a multi-service stack."}}</span>
      <select name="kind" id="src-kind-select" data-current="{{.App.Kind}}">
        <option value="nixpacks" {{if eq .App.Kind "nixpacks"}}selected{{end}}>Nixpacks build (single service)</option>
        <option value="dockerfile" {{if eq .App.Kind "dockerfile"}}selected{{end}}>Dockerfile build (single service)</option>
        <option value="compose" {{if eq .App.Kind "compose"}}selected{{end}}>Docker Compose (multi-service stack)</option>
      </select>
    </label>
    <label class="field" data-kind2="dockerfile"><span>Dockerfile {{template "hint" "Path to the Dockerfile within the repo, relative to its root. Defaults to ./Dockerfile."}}</span><input type="text" name="dockerfile_path" value="{{.App.DockerfilePath}}" placeholder="Dockerfile"></label>
    <label class="field" data-kind2="compose"><span>Compose file {{template "hint" "Path to the docker-compose file within the repo. Defaults to ./docker-compose.yml."}}</span><input type="text" name="compose_path" value="{{.App.ComposePath}}" placeholder="docker-compose.yml"></label>
    <button type="submit" class="btn">Change build type</button>
  </form>
  <p class="muted env-note">Switching between single-container and Compose changes what applies (volumes/backups vs services) — you'll confirm by typing the app name. Changes apply on the next deploy.</p>
</section>

<script>
(function () {
  var src = document.getElementById('src-source-select');
  if (src) {
    var applySrc = function () {
      document.querySelectorAll('[data-src]').forEach(function (el) {
        el.hidden = el.getAttribute('data-src').split(' ').indexOf(src.value) === -1;
      });
    };
    src.addEventListener('change', applySrc); applySrc();
  }
  var srcRepo = document.getElementById('src-github-repo');
  var srcSourceID = document.getElementById('src-git-source-id');
  var srcFilter = document.getElementById('src-repo-filter');
  // Mirrors appform.tmpl's syncRepo: picking a repo also picks its account.
  function syncSrcRepo() {
    if (!srcRepo || !srcSourceID) return;
    var opt = srcRepo.options[srcRepo.selectedIndex];
    if (!opt) return;
    srcSourceID.value = opt.getAttribute('data-source-id') || '';
  }
  if (srcRepo) { srcRepo.addEventListener('change', syncSrcRepo); syncSrcRepo(); }
  if (srcFilter && srcRepo) {
    srcFilter.addEventListener('input', function () {
      var q = srcFilter.value.toLowerCase();
      for (var i = 0; i < srcRepo.options.length; i++) {
        var o = srcRepo.options[i];
        o.hidden = q !== '' && o.value.toLowerCase().indexOf(q) === -1;
      }
    });
  }
  var kind = document.getElementById('src-kind-select');
  if (kind) {
    var applyKind = function () {
      document.querySelectorAll('[data-kind2]').forEach(function (el) {
        el.hidden = el.getAttribute('data-kind2') !== kind.value;
      });
    };
    kind.addEventListener('change', applyKind); applyKind();
  }
  window.confirmKindChange = function (form) {
    var sel = form.querySelector('#src-kind-select');
    var cur = sel.getAttribute('data-current'), next = sel.value;
    if (cur === next) return true;
    var crossing = (cur === 'compose') !== (next === 'compose');
    if (crossing) {
      var name = {{.App.Name}};
      var typed = window.prompt('Switching to/from Compose changes which data applies (volumes/backups vs services). Type the app name (' + name + ') to confirm:');
      return typed === name;
    }
    return window.confirm('Change build type from ' + cur + ' to ' + next + '? Applies on the next deploy.');
  };
})();
</script>

<section class="panel">
  <h2 class="panel-title">Connect this repo</h2>
  {{if .App.RepoURL}}
  <p class="env-note">Clone URL:</p>
  <div class="copywrap"><div class="cmd"><code>{{.App.RepoURL}}</code></div>{{template "copybtn" .}}</div>
  {{end}}
  {{if .App.SSHPublicKey}}
  <p class="env-note">Add this as a deploy key on the repository (read access):</p>
  <div class="copywrap"><div class="cmd"><code>{{.App.SSHPublicKey}}</code></div>{{template "copybtn" .}}</div>
  {{end}}
  {{if eq .App.Source "github"}}
  <p class="env-note">Auto-deploy is handled by the connected GitHub App — pushes to <span class="mono">{{.App.Branch}}</span> deploy automatically when auto-deploy is enabled. No webhook setup needed.</p>
  {{else if .WebhookURL}}
  <p class="env-note">Point a push webhook here to auto-deploy:</p>
  <div class="copywrap"><div class="cmd"><code>{{.WebhookURL}}</code></div>{{template "copybtn" .}}</div>
  {{end}}
</section>
{{end}}

<section class="panel">
  <h2 class="panel-title">Environment</h2>
  {{if .Env}}
  <table class="table">
    <thead><tr><th>Key</th><th>Value</th><th></th></tr></thead>
    <tbody>
      {{range .Env}}
      <tr>
        <td class="mono">{{.Key}}{{if ne .Scope "shared"}}{{if ne .Scope ""}} <span class="badge">{{.Scope}}</span>{{end}}{{end}}</td>
        <td class="mono muted">
          <span data-env-val>{{if .IsSecret}}••••••{{else}}{{.Value}}{{end}}</span>
          <form method="post" action="/apps/{{$.App.ID}}/env" class="env-edit" data-env-edit hidden>
            <input type="hidden" name="key" value="{{.Key}}">
            <input type="hidden" name="scope" value="{{if .Scope}}{{.Scope}}{{else}}shared{{end}}">
            {{if .IsSecret}}<input type="hidden" name="secret" value="on"><input type="text" name="value" placeholder="enter new value" required>{{else}}<input type="text" name="value" value="{{.Value}}">{{end}}
            <button type="submit" class="btn btn-quiet">Save</button>
            <button type="button" class="linkbtn" data-env-cancel>Cancel</button>
          </form>
        </td>
        <td class="row-actions">
          <button type="button" class="linkbtn" data-env-editbtn>edit</button>
          <form method="post" action="/apps/{{$.App.ID}}/env/delete" class="inline">
            <input type="hidden" name="key" value="{{.Key}}">
            <button type="submit" class="linkbtn">remove</button>
          </form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="empty">No environment variables.</p>
  {{end}}
  <form method="post" action="/apps/{{.App.ID}}/env" class="grid-form env-add">
    <label class="field"><span>Key</span><input type="text" name="key" placeholder="LOG_LEVEL" required></label>
    <label class="field"><span>Value</span><input type="text" name="value" placeholder="info"></label>
    <label class="field"><span>Scope</span>
      <select name="scope">
        <option value="shared" selected>Shared</option>
        <option value="prod">Production only</option>
        <option value="preview">Preview only</option>
      </select>
    </label>
    <label class="field"><span>Secret</span><input type="checkbox" name="secret"></label>
    <button type="submit" class="btn btn-primary">Add</button>
  </form>
  <p class="muted env-note">Values may reference the project's shared variables as <span class="mono">{{"${{project.KEY}}"}}</span>, resolved on deploy. Redeploy to apply env changes.</p>
</section>

<script>
(function () {
  document.addEventListener('click', function (e) {
    var t = e.target;
    if (t.closest && t.closest('[data-env-editbtn]')) {
      var row = t.closest('tr');
      row.querySelector('[data-env-val]').hidden = true;
      row.querySelector('[data-env-edit]').hidden = false;
    } else if (t.closest && t.closest('[data-env-cancel]')) {
      var r2 = t.closest('tr');
      r2.querySelector('[data-env-edit]').hidden = true;
      r2.querySelector('[data-env-val]').hidden = false;
    }
  });
})();
</script>

<section class="panel danger-zone">
  <h2 class="panel-title">Danger zone</h2>
  <p class="muted">Deleting an app removes it and all its deployments, domains, env vars, volumes, and backups. This cannot be undone.</p>
  <form method="post" action="/apps/{{.App.ID}}/delete" class="inline" onsubmit="return confirm('Delete {{.App.Name}} and all its deployments?');"><button type="submit" class="btn btn-danger">Delete app</button></form>
</section>
</section>

<script>
(function () {
  var bar = document.getElementById('app-tabs');
  if (!bar) return;
  var links = Array.prototype.slice.call(bar.querySelectorAll('[data-tab-link]'));
  var panels = Array.prototype.slice.call(document.querySelectorAll('.tab[data-tab]'));
  var names = panels.map(function (p) { return p.getAttribute('data-tab'); });
  function activate(name) {
    if (names.indexOf(name) === -1) name = names[0];
    panels.forEach(function (p) { p.hidden = p.getAttribute('data-tab') !== name; });
    links.forEach(function (a) { a.classList.toggle('active', a.getAttribute('data-tab-link') === name); });
  }
  function fromHash() { activate((location.hash || '').replace(/^#/, '')); }
  window.addEventListener('hashchange', fromHash);
  fromHash();
})();
</script>

<script>
(function () {
  document.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest('.copybtn');
    if (!btn) return;
    var wrap = btn.closest('.copywrap');
    var src = wrap && wrap.querySelector('code, pre');
    var text = src ? src.textContent : '';
    if (!navigator.clipboard || !text) return;
    navigator.clipboard.writeText(text).then(function () {
      var old = btn.textContent;
      btn.textContent = 'copied';
      btn.classList.add('copied');
      setTimeout(function () { btn.textContent = old; btn.classList.remove('copied'); }, 1200);
    });
  });
})();
</script>
{{end}}
