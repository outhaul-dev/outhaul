{{define "content"}}
<div class="pagehead">
  <div>
    <div class="crumbs"><a href="/projects">Projects</a> / {{with .Project}}<a href="/projects/{{.ID}}">{{.Name}}</a> / {{end}}{{.App.Name}}</div>
    <h1>{{.App.Name}}{{if eq .App.Kind "compose"}} <span class="badge">Compose</span>{{end}}</h1>
  </div>
  <div class="pagehead-actions">
    <span class="badge state-{{if eq .Runtime "running"}}running{{else}}stopped{{end}}">{{.Runtime}}</span>
    <form method="post" action="/apps/{{.App.ID}}/deploy" class="inline"><button type="submit" class="btn btn-primary">Deploy</button></form>
    <form method="post" action="/apps/{{.App.ID}}/stop" class="inline"><button type="submit" class="btn">Stop</button></form>
    <form method="post" action="/apps/{{.App.ID}}/restart" class="inline"><button type="submit" class="btn">Restart</button></form>
    <form method="post" action="/apps/{{.App.ID}}/delete" class="inline" onsubmit="return confirm('Delete {{.App.Name}} and all its deployments?');"><button type="submit" class="btn btn-danger">Delete</button></form>
  </div>
</div>

<section class="panel">
  <dl class="meta">
    {{if eq .App.Kind "compose"}}
    <div><dt>Domains</dt><dd>{{if .Domains}}{{range .Domains}}<div><a href="http://{{.Domain}}" target="_blank" rel="noreferrer" class="mono">{{.Domain}}</a> <span class="muted mono">→ {{.Service}}:{{.Port}}</span></div>{{end}}{{else}}<span class="muted">— internal only</span>{{end}}</dd></div>
    {{else}}
    <div><dt>Domain</dt><dd>{{if .App.Domain}}<a href="http://{{.App.Domain}}" target="_blank" rel="noreferrer" class="mono">{{.App.Domain}}</a>{{else}}<span class="muted">— internal only</span>{{end}}</dd></div>
    {{end}}
    <div><dt>Repository</dt><dd class="mono">{{.App.RepoURL}}</dd></div>
    {{if eq .App.Kind "compose"}}<div><dt>Compose file</dt><dd class="mono">{{.App.ComposePath}}</dd></div>{{end}}
  </dl>
</section>

{{if eq .App.Kind "compose"}}
<section class="panel">
  <h2 class="panel-title">Services</h2>
  {{if .Stack}}
  <table class="table">
    <thead><tr><th>Service</th><th>State</th></tr></thead>
    <tbody>
      {{range .Stack}}
      <tr>
        <td class="mono">{{.Service}}</td>
        <td><span class="badge state-{{if eq .State "running"}}running{{else}}stopped{{end}}">{{.State}}</span></td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="empty">No stack containers yet. Deploy to bring the stack up.</p>
  {{end}}
</section>

<section class="panel">
  <h2 class="panel-title">Domains</h2>
  {{if .Domains}}
  <table class="table">
    <thead><tr><th>Domain</th><th>Service</th><th>Port</th><th></th></tr></thead>
    <tbody>
      {{range .Domains}}
      <tr>
        <td><a href="http://{{.Domain}}" target="_blank" rel="noreferrer" class="mono">{{.Domain}}</a></td>
        <td class="mono">{{.Service}}</td>
        <td class="mono">{{.Port}}</td>
        <td>
          <form method="post" action="/apps/{{$.App.ID}}/domains/{{.ID}}/delete" class="inline">
            <button type="submit" class="linkbtn">remove</button>
          </form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="empty">No domains — the stack is internal-only until a service is published on one.</p>
  {{end}}
  <form method="post" action="/apps/{{.App.ID}}/domains" class="grid-form env-add">
    <label class="field"><span>Domain</span><input type="text" name="domain" placeholder="shop.example.com" required></label>
    <label class="field"><span>Service</span><input type="text" name="service" placeholder="web" required></label>
    <label class="field"><span>Port</span><input type="text" name="port" placeholder="3000" inputmode="numeric" required></label>
    <button type="submit" class="btn btn-primary">Add</button>
  </form>
  <p class="muted env-note">Each domain routes to one compose service's container port; several domains may share a service. Redeploy to apply domain changes.</p>
</section>
{{end}}

<section class="panel">
  <div class="log-head">
    <h2 class="panel-title">Metrics</h2>
    <span class="not-live">not live</span>
  </div>
  <div class="stats">
    <div class="stat"><div class="stat-label">CPU</div><div class="stat-value">—<span class="unit">%</span></div><div class="stat-sub">coming soon</div></div>
    <div class="stat"><div class="stat-label">Memory</div><div class="stat-value">—<span class="unit">MB</span></div><div class="stat-sub">coming soon</div></div>
    <div class="stat"><div class="stat-label">Net I/O</div><div class="stat-value">—<span class="unit">MB/s</span></div><div class="stat-sub">coming soon</div></div>
    <div class="stat"><div class="stat-label">Uptime</div><div class="stat-value">—</div><div class="stat-sub">coming soon</div></div>
  </div>
</section>

<section class="panel">
  <h2 class="panel-title">Deploy settings</h2>
  <form method="post" action="/apps/{{.App.ID}}/settings" class="grid-form">
    <label class="field"><span>Source</span><input type="text" value="{{.App.Source}}" disabled></label>
    <label class="field"><span>Branch</span><input type="text" name="branch" value="{{.App.Branch}}"></label>
    {{if eq .App.Kind "compose"}}
    <label class="field"><span>Compose file</span><input type="text" name="compose_path" value="{{.App.ComposePath}}"></label>
    {{end}}
    <label class="field-check"><input type="checkbox" name="auto_deploy" {{if .App.AutoDeploy}}checked{{end}}> <span>Auto-deploy on push</span></label>
    <label class="field field-wide">
      <span>Watch paths</span>
      <textarea name="watch_paths" rows="3" placeholder="src/**&#10;package.json">{{joinLines .App.WatchPaths}}</textarea>
    </label>
    <button type="submit" class="btn">Save</button>
  </form>
  <p class="muted env-note">Watch paths: one glob per line (<span class="mono">*</span> within a folder, <span class="mono">**</span> across folders). When set, a push only auto-deploys if it changed a matching file; leave empty to deploy on every push to the branch.</p>
</section>

<section class="panel">
  <h2 class="panel-title">Connect this repo</h2>
  {{if .App.RepoURL}}
  <p class="env-note">Clone URL:</p>
  <div class="cmd"><code>{{.App.RepoURL}}</code></div>
  {{end}}
  {{if .App.SSHPublicKey}}
  <p class="env-note">Add this as a deploy key on the repository (read access):</p>
  <div class="cmd"><code>{{.App.SSHPublicKey}}</code></div>
  {{end}}
  {{if eq .App.Source "github"}}
  <p class="env-note">Auto-deploy is handled by the connected GitHub App — pushes to <span class="mono">{{.App.Branch}}</span> deploy automatically when auto-deploy is enabled. No webhook setup needed.</p>
  {{else if .WebhookURL}}
  <p class="env-note">Point a push webhook here to auto-deploy:</p>
  <div class="cmd"><code>{{.WebhookURL}}</code></div>
  {{end}}
</section>

<section class="panel">
  <h2 class="panel-title">Environment</h2>
  {{if .Env}}
  <table class="table">
    <thead><tr><th>Key</th><th>Value</th><th></th></tr></thead>
    <tbody>
      {{range .Env}}
      <tr>
        <td class="mono">{{.Key}}</td>
        <td class="mono muted">{{if .IsSecret}}••••••{{else}}{{.Value}}{{end}}</td>
        <td>
          <form method="post" action="/apps/{{$.App.ID}}/env/delete" class="inline">
            <input type="hidden" name="key" value="{{.Key}}">
            <button type="submit" class="linkbtn">remove</button>
          </form>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="empty">No environment variables.</p>
  {{end}}
  <form method="post" action="/apps/{{.App.ID}}/env" class="grid-form env-add">
    <label class="field"><span>Key</span><input type="text" name="key" placeholder="LOG_LEVEL" required></label>
    <label class="field"><span>Value</span><input type="text" name="value" placeholder="info"></label>
    <label class="field"><span>Secret</span><input type="checkbox" name="secret"></label>
    <button type="submit" class="btn btn-primary">Add</button>
  </form>
  <p class="muted env-note">Redeploy to apply env changes.</p>
</section>

<section class="panel">
  <h2 class="panel-title">Deployments</h2>
  {{if .Deployments}}
  <table class="table">
    <thead>
      <tr><th>#</th><th>Status</th><th>Created</th><th>Build</th><th></th></tr>
    </thead>
    <tbody>
      {{range .Deployments}}
      <tr>
        <td class="mono">{{.ID}}</td>
        <td><span class="badge {{stateClass .Status}}">{{.Status}}</span></td>
        <td class="mono muted">{{fmtTime .CreatedAt}}</td>
        <td class="mono muted">{{buildDur .}}</td>
        <td><a href="/deployments/{{.ID}}" class="rowlink">logs →</a></td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="empty">No deployments yet. Click <strong>Deploy</strong> to build and launch this app.</p>
  {{end}}
</section>
{{end}}
